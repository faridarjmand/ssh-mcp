# SSH_NEXUS_CONFIG defaults to ~/.ssh/config
SSH_NEXUS_CONFIG=~/.ssh/config
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3100

# Required if DASHBOARD_HOST is not a loopback address.
# Generate with: openssl rand -hex 32
# SSH_NEXUS_TOKEN=

# Colon-separated on macOS/Linux; semicolon-separated on Windows.
PROJECT_ROOTS=.
SSH_CHECK_TIMEOUT_MS=3500
SSH_COMMAND_TIMEOUT_MS=12000
METRICS_CACHE_MS=10000
MAX_INDEX_FILES=5000

# Dangerous: allows the MCP run_ssh_command tool. Keep false unless intended.
ALLOW_REMOTE_COMMANDS=false
